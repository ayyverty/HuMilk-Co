<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RJWQuirks.QuirkDef MayRequire="rjw.quirks">
    <defName>Lactation</defName>
    <label>Lactation</label>
    <description>{pawn} is turned on by lactation. {pawn_pronoun} gets aroused when {pawn_possessive} partner is lactating.</description>
    <iconPath>UI/Icons/Quirks/Lactation</iconPath>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <satisfiedBy Class="RJWQuirks.Condition.PartnerHasHediff">
      <hediff>Lactating</hediff>
    </satisfiedBy>
    <requires Class="RJWQuirks.Requirement.LogicalNot">
      <requirement Class="RJWQuirks.Requirement.IsAnimal" />
    </requires>
    <commonality>0.1</commonality>
  </RJWQuirks.QuirkDef>

</Defs>
