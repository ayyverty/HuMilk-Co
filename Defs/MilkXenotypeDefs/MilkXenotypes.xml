<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Links each xenotype to the milk its pawns produce and the effect that milk
       grants. Add entries here to map custom xenotypes from other mods. -->

  <MilkXenotypeDef MayRequire="ludeon.rimworld.biotech">
    <defName>MilkXenotypeGenie</defName>
    <xenotype>Genie</xenotype>
    <milk>MilkHumanGenie</milk>
    <effect>MilkEffectGenie</effect>
