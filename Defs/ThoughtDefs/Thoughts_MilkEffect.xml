<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Mood thought shared by every milk effect. The magnitude is not set here: the
       thought class reads it live from whichever mood comps the pawn is carrying,
       so one def serves positive and negative effects alike. baseMoodEffect is 0
       and is only a placeholder for the label/description. Non-stacking. -->
  <ThoughtDef>
    <defName>MilkEffectMood</defName>
    <thoughtClass>HuMilkCo.Thought_MilkEffectMood</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>Milk Effect</label>
        <description>The compounds in the milk I drank are still working through me.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>