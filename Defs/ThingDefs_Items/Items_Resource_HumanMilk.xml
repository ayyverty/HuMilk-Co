<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Shared base for all HuMilk Co milk. Per-milk defs inherit this and add their
       own market value, tint, and (for xenotype milks) an effect ingestion doer. -->
  <ThingDef Abstract="True" Name="HumanMilkBase" ParentName="OrganicProductBase">
    <label>Human Milk</label>
    <description>Milk expressed from a lactating human or human-like pawn. A natural commodity in colonies that keep milkable pawns.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Milk</texPath>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <Mass>0.045</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Nutrition>0.05</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>14</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawTasty</preferability>
      <foodType>AnimalProduct, Fluid</foodType>
      <babiesCanIngest>true</babiesCanIngest>
    </ingestible>
    <thingCategories>
      <li>AnimalProductRaw</li>
    </thingCategories>
    <allowedArchonexusCount>80</allowedArchonexusCount>
  </ThingDef>

  <!-- Default milk produced by baseliners and any pawn without a mapped xenotype.
       No special effect. -->
  <ThingDef ParentName="HumanMilkBase">
    <defName>MilkHuman</defName>
    <label>Human Milk</label>
    <description>Milk expressed from a lactating human or human-like pawn. A natural commodity in colonies that keep milkable pawns.</description>
    <statBases>
      <MarketValue>6</MarketValue>
    </statBases>
  </ThingDef>

</Defs>