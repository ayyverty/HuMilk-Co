  <!-- Boglegs (Det's Xenotypes - Boglegs) -->
  <ThingDef ParentName="HumanMilkBase" MayRequire="det.boglegs">
    <defName>MilkHumanBogleg</defName>
    <label>Bog Milk</label>
    <description>Thick, oily and foul-tasting. The drinker heals quickly and shrugs off disease, and can talk a merchant down to his last credit - but they will not be happy about any of it.</description>
    <graphicData>
      <color>(0.55,0.55,0.25)</color>
    </graphicData>
    <statBases>
      <MarketValue>12</MarketValue>
    </statBases>
    <ingestible>
      <outcomeDoers>
        <li Class="HuMilkCo.IngestionOutcomeDoer_MilkEffect" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <!-- Stoneborn (Det's Xenotypes - Stoneborn) -->
  <ThingDef ParentName="HumanMilkBase" MayRequire="det.stoneborn">
    <defName>MilkHumanStoneborn</defName>
    <label>Stone Milk</label>
    <description>A hard, sediment-heavy drink that leaves a stoneborn in the gut. The drinker builds and mines with a stoneborn's ease and lifts their spirits - and it goes down like strong liquor.</description>
    <graphicData>
      <color>(0.62,0.62,0.65)</color>
    </graphicData>
    <statBases>
      <MarketValue>18</MarketValue>
    </statBases>
    <ingestible>
      <drugCategory>Hard</drugCategory>
      <outcomeDoers>
        <li Class="HuMilkCo.IngestionOutcomeDoer_MilkEffect" />
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholHigh</hediffDef>
          <severity>0.30</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

