    <defName>MilkHumanHalffoot</defName>
    <label>Half-Foot Milk</label>
    <description>A rich, satisfying milk for small hands. It sharpens the drinker's crafting and speeds their steps, though it does nothing for their manners or their fists.</description>
    <graphicData>
      <color>(0.93,0.89,0.78)</color>
    </graphicData>
    <statBases>
