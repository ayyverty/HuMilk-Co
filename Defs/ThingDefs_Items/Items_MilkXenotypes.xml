<Defs>

  <!-- Genie -->
  <ThingDef ParentName="HumanMilkBase">
    <defName>MilkHumanGenie</defName>
    <label>Genie Milk</label>
    <description>Infused with the genie's intellect, this milk sharpens the mind but decreases pain tolerance.</description>
    <graphicData>
      <color>(0.70,0.85,1.00)</color>
    </graphicData>
    <statBases>
      <MarketValue>18</MarketValue>
    </statBases>
    <ingestible>
      <outcomeDoers>
        <li Class="HuMilkCo.IngestionOutcomeDoer_MilkEffect" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>

